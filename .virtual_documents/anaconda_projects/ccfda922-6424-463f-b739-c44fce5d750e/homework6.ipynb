#3.1 1D Numpy Arrays


import numpy as np


list = [20, 27, 9, 12, 31, 17, 4, 50, 39, 35]
arr = np.array([list])

print(arr*4)


np.mean(arr)


np.median(arr)


np.std(arr)


np.argmin(arr)


np.argmax(arr)


print(arr[0, 6])


print(arr[0, 7])


np.min(arr)


np.max(arr)


# Yes, they match those from the previous step.


new_array = arr[arr>20]
print(new_array)


#3.2 2D numpy arrays


matrix = np.array([[5, 12, 17, 9], [8, 21, 14, 3],[6, 13, 19, 11]])


print(matrix) # There are 3 rows and 4 columns


print(matrix[::, 2])


print(matrix[1])


print(matrix * 2)


print(np.mean(matrix[:,0])) #mean value of each column


print(np.mean(matrix[:,1]))


print(np.mean(matrix[:,2]))


print(np.mean(matrix[:,3]))


print(np.mean(matrix))


print(np.max(matrix[0])) #max value in each row, min value in each column


print(np.max(matrix[1]))


print(np.max(matrix[2]))


print(np.max(matrix[3]))



